# Demo Environment Configuration Template
# Copy this file to .env.local to configure demo credentials for local development.
# NOTE: Environment variables are exposed in the client-side JavaScript bundle.

# ESG Admin Demo Authentication
VITE_ENABLE_DEMO_AUTH=false
VITE_DEMO_ADMIN_EMAIL=
VITE_DEMO_ADMIN_PASSWORD=

# Reviewer / Approver Demo Authentication
VITE_ENABLE_DEMO_REVIEWER_AUTH=
VITE_DEMO_REVIEWER_EMAIL=
VITE_DEMO_REVIEWER_PASSWORD=
